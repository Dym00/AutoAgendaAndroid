{
  "appId": "br.com.autoagenda",
  "appName": "AutoAgenda",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "cleartext": true
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    },
    "SplashScreen": {
      "launchShowDuration": 10000,
      "launchAutoHide": false,
      "backgroundColor": "#ffffff",
      "androidSplashResourceName": "splash",
      "showSpinner": true,
      "androidSpinnerStyle": "large",
      "spinnerColor": "#3b82f6"
    }
  }
}
